# dependencies
node_modules/

# Expo
.expo/
dist/
dist-check*/
web-build/
expo-env.d.ts
.expo-home/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local tooling and credentials are not build inputs
.claude/
.env
.env.*
!.env.example

# Only publishable client configuration used by native builds (not Git).
!.env.local
.firebase/
*debug.log
test-results/
